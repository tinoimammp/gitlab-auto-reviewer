# Required
WEBHOOK_SECRET=fill-in-your-own-random-string
TARGET_USER_ID=
TARGET_USERNAME=tinoimammp
REPOS_ROOT=/Users/tinoimammp/sc-personal

# Optional (defaults live in config.js)
PORT=3001
CLAUDE_CODE_BIN=claude
REPO_INDEX_REFRESH_MS=300000
MCP_HEALTH_CACHE_MS=60000
REVIEW_TIMEOUT_MS=600000
# Set to "false" to disable auto-starting ngrok on npm start (needs the ngrok CLI + login)
ENABLE_NGROK=true
# Your free ngrok static domain (dashboard.ngrok.com → Domains), e.g. xxx.ngrok-free.app.
# Keeps the webhook URL the same across restarts. Leave blank for a random URL.
NGROK_DOMAIN=
# Set to "false" to disable re-reviewing an MR when new commits are pushed to it
ENABLE_REVIEW_ON_PUSH=true
# Set to "false" to disable the startup catch-up scan (see GITLAB_URL/GITLAB_TOKEN below)
ENABLE_STARTUP_CATCHUP=true
# Set to "true" to let the review approve MRs with zero major/minor findings.
# Off by default: MR content is untrusted and could prompt-inject an approval.
ALLOW_AUTO_APPROVE=false
# Comma-separated GitLab usernames allowed to trigger a review. Empty = anyone.
TRUSTED_ACTORS=

# Optional — used for the startup catch-up scan (finding MRs that assigned
# you as reviewer/mentioned you before this server started, via the GitLab
# Todos API) and the approval check on push. Leave blank if not needed.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
